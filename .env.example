# HeyGen Automation Configuration

# Name of the template to use in HeyGen
# Defaults to "Pratham-Template" if not set
TEMPLATE_NAME=Pratham-Template

# Chrome Remote Debugging Endpoint
# Defaults to http://127.0.0.1:9222
CDP_ENDPOINT=http://127.0.0.1:9222

# NOTE: The following variables are set AUTOMATICALLY by the batch runner
# You do NOT need to set these manually for batch processing.
# AUDIO_PATH=/path/to/audio/file.mp3
# VIDEO_NAME=MyVideoName